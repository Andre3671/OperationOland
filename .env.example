# Copy this file to .env.local and fill in your key.
# .env.local is gitignored by default in Vite projects.

# OpenRouteService API key — required for road-following routes that avoid motorways.
# Sign up free at https://openrouteservice.org/dev/#/signup (2000 requests/day on the free tier).
# NEVER put a real key in this file — it is tracked by git.
VITE_ORS_API_KEY=your-openrouteservice-key-here

# Backend (sync server) origin for builds where the UI is NOT served from the
# same host as the API — primarily the native Android/iOS app (Capacitor),
# where the UI is bundled inside the app. No trailing slash. The WebSocket
# URL (ws:// or wss://) is derived from this origin automatically.
#
#   - Web build: leave EMPTY -> relative /api calls, same-origin as before
#     (nginx / vite dev proxy handles them). Nothing changes.
#   - Native app build: if empty, the app falls back to
#     NATIVE_DEFAULT_API_BASE in src/lib/apiBase.js (the production server).
#     Set this to override, e.g. a LAN test server:
#     VITE_API_BASE=http://192.168.0.6:8091
#
# Baked in at BUILD time (vite build / npm run android:sync).
VITE_API_BASE=
