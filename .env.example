# Copy this file to .env.local and fill in your key.
# .env.local is gitignored by default in Vite projects.

# OpenRouteService API key — required for road-following routes that avoid motorways.
# Sign up free at https://openrouteservice.org/dev/#/signup (2000 requests/day on the free tier).
# NEVER put a real key in this file — it is tracked by git.
VITE_ORS_API_KEY=your-openrouteservice-key-here
